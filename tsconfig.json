{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["ES2020"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
        "$src/*": ["./src/*"],
        "$env":["./src/env.ts"],
        "$db":["./src/db/*"]
    },
  }
}