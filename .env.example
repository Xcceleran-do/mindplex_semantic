DB_USER=mindplex
DB_PASSWORD=mindplex
DB_NAME=semantic
DB_PORT=5432

NODE_ENV=development
DOCKER_TARGET=development
API_PORT=3000
DATABASE_URL=postgres://mindplex:mindplex@localhost:5432/semantic
DB_ADMIN_DATABASE=postgres
DB_REQUIRE_SSL=false

REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# API key auth for ingestion and mutating routes.
INGEST_API_KEY=replace-with-a-shared-secret
API_KEY=replace-with-a-shared-secret

# JWT auth: configure one verification mode. Mindplex backend default is EdDSA JWKS.
JWT_SECRET=
JWT_PUBLIC_JWK=
JWT_PUBLIC_KEY=
JWT_JWKS_URI=
JWT_ALG=EdDSA
JWT_ALLOWED_ALGS=
JWT_ISSUER=mindplex
JWT_AUDIENCE=mindplex-api
JWT_ROLE_CLAIM=

# AWS Bedrock embeddings.
AWS_BEDROCK_ACCESS_KEY=
AWS_BEDROCK_SECRET_KEY=
AWS_REGION=us-east-1
AWS_MAX_ATTEMPTS=3
AWS_BEDROCK_HTTP1=true
AWS_RETRY_BASE_DELAY_MS=750
AWS_BEDROCK_REQUEST_TIMEOUT_MS=30000
EMBEDDING_BATCH_SIZE=1

# Article seeding from staging.
STAGING_API_URL=
STAGING_API_KEY=
SEED_COUNT=25

# Search benchmark defaults.
BENCH_BASE_URL=http://localhost:3000
BENCH_ARTICLES=24
BENCH_CONCURRENCY=3
BENCH_REPEATS=3
BENCH_LIMIT=10
BENCH_ID_BASE=880000000
BENCH_SEED=true
BENCH_RESET=false
BENCH_CLEANUP=false
BENCH_TIMEOUT_MS=60000
BENCH_INGEST_DELAY_MS=0
BENCH_SEARCH_DELAY_MS=250
BENCH_SHOW_RESULTS=false
BENCH_TOP_K=3
